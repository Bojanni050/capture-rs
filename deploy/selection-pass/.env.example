TAILSCALE_IP=100.64.144.93
HINDSIGHT_BANK_ID=bojan
RUN_INTERVAL_SEC=1800

# LLM relevance filter -- a second, content-aware pass on top of the
# mechanical noise/length filters in run.py. Set RELEVANCE_FILTER_ENABLED
# to false to skip it (falls back to the mechanical filters only).
RELEVANCE_FILTER_ENABLED=true
LLM_API_KEY=reuse-the-key-already-set-on-the-hindsight-container-or-provide-your-own
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash
